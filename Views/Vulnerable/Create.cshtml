@model VulFormVm
@{ var f = Model.Form; ViewData["Title"] = "เพิ่มบุคคลในกลุ่มเปราะบาง"; }
<div class="page-head"><div><h4 class="page-title"><i class="bi bi-shield-plus"></i> @ViewData["Title"]</h4></div></div>
@if (Model.Error != null) { <div class="alert alert-danger border-0 shadow-sm rounded-4">@Model.Error</div> }
<form asp-action="Create" method="post" autocomplete="off">
  <div class="card border-0 shadow-sm rounded-4 mb-4"><div class="card-header fw-bold py-3 px-4">เลือกบุคคล</div>
    <div class="card-body p-4"><partial name="_Picker" model="Model.Picker" /></div></div>
  <div class="card border-0 shadow-sm rounded-4 mb-4"><div class="card-header fw-bold py-3 px-4">กลุ่มเปราะบาง</div><div class="card-body p-4"><div class="row g-3">
    <div class="col-md-6"><label class="form-label small fw-semibold">ประเภทกลุ่ม</label><select name="VulnerableTypeId" class="form-select" required><option value="">-- เลือกกลุ่ม --</option>
      @foreach (var t in Model.Types) { <option value="@t.Id" selected="@(t.Id == f.VulnerableTypeId?.ToString())">@t.Id. @t.Name</option> }</select></div>
    <div class="col-md-3"><label class="form-label small fw-semibold">วันที่ระบุ</label><input type="date" name="IdentifiedDate" value="@(f.IdentifiedDate?.ToString("yyyy-MM-dd"))" class="form-control" /></div>
    <div class="col-md-12"><label class="form-label small fw-semibold">หมายเหตุ</label><input name="Note" value="@f.Note" maxlength="255" class="form-control" /></div>
  </div></div></div>
  <button class="btn btn-success rounded-3 px-4 fw-semibold"><i class="bi bi-check-lg"></i> บันทึก</button>
  <a class="btn btn-outline-secondary rounded-3 px-4" href="javascript:history.back()">ยกเลิก</a>
</form>
@section Scripts { <partial name="_PickerScript" /> }
