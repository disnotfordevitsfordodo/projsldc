@model WelfareVm
@{ ViewData["Title"] = "บัตรสวัสดิการแห่งรัฐ"; }

<!-- ส่วนหัวเรื่อง (Header) -->
<div class="page-head">
  <div>
    <h4 class="page-title">
      <i class="bi bi-card-checklist"></i> บัตรสวัสดิการแห่งรัฐ (ปี พ.ศ. @Model.Year)
    </h4>
    <div class="page-sub">
      ระบบตรวจสอบและติดตามกลุ่มเป้าหมายสวัสดิการแห่งรัฐ จังหวัดสกลนคร
    </div>
  </div>
  <div class="page-actions">
    <partial name="_YearSelect" model="Model.Year" />
  </div>
</div>

<!-- การ์ดสรุปตัวเลข 5 ช่อง สไตล์ซอฟต์ -->
<div class="row g-2 mb-4">
  <!-- 1. รายชื่อทั้งหมด -->
  <div class="col-12 col-sm-6 col-xl">
    <div class="card border-0 shadow-sm rounded-4 h-100 p-3" style="background-color: #f0f9ff; border-left: 5px solid #0284c7 !important;">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <div class="fs-3 fw-bold text-dark">@Model.SumAll.ToString("N0")</div>
          <div class="small text-secondary fw-semibold mt-1">รายชื่อทั้งหมด</div>
        </div>
        <div class="rounded-circle p-2 d-flex align-items-center justify-content-center" style="background-color: rgba(2, 132, 199, 0.1); width: 46px; height: 46px;">
          <i class="bi bi-people-fill fs-4 text-primary"></i>
        </div>
      </div>
    </div>
  </div>

  <!-- 2. กลุ่ม 1 ผู้ถือบัตร -->
  <div class="col-12 col-sm-6 col-xl">
    <div class="card border-0 shadow-sm rounded-4 h-100 p-3" style="background-color: #f0fdf4; border-left: 5px solid #16a34a !important;">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <div class="fs-3 fw-bold text-dark">@Model.SumG1.ToString("N0")</div>
          <div class="small text-secondary fw-semibold mt-1">กลุ่ม 1 ผู้ถือบัตร</div>
        </div>
        <div class="rounded-circle p-2 d-flex align-items-center justify-content-center" style="background-color: rgba(22, 163, 74, 0.1); width: 46px; height: 46px;">
          <i class="bi bi-card-heading fs-4 text-success"></i>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. กลุ่ม 2 ชายขอบ/ตกหล่น -->
  <div class="col-12 col-sm-6 col-xl">
    <div class="card border-0 shadow-sm rounded-4 h-100 p-3" style="background-color: #fefce8; border-left: 5px solid #eab308 !important;">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <div class="fs-3 fw-bold text-dark">@Model.SumG2.ToString("N0")</div>
          <div class="small text-secondary fw-semibold mt-1">กลุ่ม 2 ชายขอบ/ตกหล่น</div>
        </div>
        <div class="rounded-circle p-2 d-flex align-items-center justify-content-center" style="background-color: rgba(234, 179, 8, 0.15); width: 46px; height: 46px;">
          <i class="bi bi-exclamation-triangle-fill fs-4 text-warning"></i>
        </div>
      </div>
    </div>
  </div>

  <!-- 4. กลุ่ม 3 ไม่ใช่เป้าหมาย -->
  <div class="col-12 col-sm-6 col-xl">
    <div class="card border-0 shadow-sm rounded-4 h-100 p-3" style="background-color: #fef2f2; border-left: 5px solid #dc2626 !important;">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <div class="fs-3 fw-bold text-dark">@Model.SumG3.ToString("N0")</div>
          <div class="small text-secondary fw-semibold mt-1">กลุ่ม 3 ไม่ใช่เป้าหมาย</div>
        </div>
        <div class="rounded-circle p-2 d-flex align-items-center justify-content-center" style="background-color: rgba(220, 38, 38, 0.1); width: 46px; height: 46px;">
          <i class="bi bi-x-circle-fill fs-4 text-danger"></i>
        </div>
      </div>
    </div>
  </div>

  <!-- 5. รอการสำรวจ -->
  <div class="col-12 col-sm-6 col-xl">
    <div class="card border-0 shadow-sm rounded-4 h-100 p-3" style="background-color: #f8fafc; border-left: 5px solid #64748b !important;">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <div class="fs-3 fw-bold text-dark">@Model.SumWait.ToString("N0")</div>
          <div class="small text-secondary fw-semibold mt-1">รอการสำรวจ</div>
        </div>
        <div class="rounded-circle p-2 d-flex align-items-center justify-content-center" style="background-color: rgba(100, 116, 139, 0.1); width: 46px; height: 46px;">
          <i class="bi bi-hourglass-split fs-4 text-secondary"></i>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ฟอร์มค้นหาและตัวกรองข้อมูล -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
  <div class="card-body p-3">
    <form method="get" class="row g-2 align-items-center">
      <input type="hidden" name="year" value="@Model.Year" />
      
      <!-- ตัวเลือกอำเภอ -->
      <div class="col-12 col-md-3">
        <select name="amphurId" class="form-select form-select-sm rounded-3" onchange="this.form.tumbolId.value=''; this.form.submit()">
          <option value="">-- ทุกอำเภอ --</option>
          @foreach (var a in Model.Amphurs) { 
            <option value="@a.Id" selected="@(a.Id == Model.AmphurId)">อ.@a.Name</option> 
          }
        </select>
      </div>

      <!-- ตัวเลือกตำบล -->
      <div class="col-12 col-md-3">
        <select name="tumbolId" class="form-select form-select-sm rounded-3" onchange="this.form.submit()">
          <option value="">-- ทุกตำบล --</option>
          @foreach (var t in Model.Tumbols) { 
            <option value="@t.Id" selected="@(t.Id == Model.TumbolId)">ต.@t.Name</option> 
          }
        </select>
      </div>

      <!-- ตัวเลือกกลุ่ม -->
      <div class="col-12 col-md-3">
        <select name="group" class="form-select form-select-sm rounded-3" onchange="this.form.submit()">
          <option value="">-- ทุกกลุ่ม --</option>
          <option value="1" selected="@(Model.Group == 1)">กลุ่ม 1 : ผู้ถือบัตร</option>
          <option value="2" selected="@(Model.Group == 2)">กลุ่ม 2 : ชายขอบ/ตกหล่น</option>
          <option value="3" selected="@(Model.Group == 3)">กลุ่ม 3 : ไม่ใช่เป้าหมาย</option>
          <option value="0" selected="@(Model.Group == 0)">รอการสำรวจ</option>
        </select>
      </div>

      <!-- ช่องค้นหา -->
      <div class="col-12 col-md-3">
        <div class="input-group input-group-sm">
          <input name="q" value="@Model.Q" class="form-control rounded-start-3" placeholder="ค้นหาชื่อ / รหัสบ้าน" />
          <button class="btn btn-primary rounded-end-3 px-3 fw-semibold" type="submit">
            <i class="bi bi-search me-1"></i>ค้นหา
          </button>
        </div>
      </div>
    </form>
  </div>
</div>

<!-- ตารางสรุปข้อมูลรายตำบล (แสดงเฉพาะเมื่อมีรายการไม่เกิน 40 ตำบล) -->
@if (Model.Summary.Count > 0 && Model.Summary.Count <= 40)
{
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="card-header py-3 px-4 d-flex align-items-center justify-content-between border-0">
      <div class="fw-bold fs-6 d-flex align-items-center gap-2">
        <i class="bi bi-geo-alt"></i> สรุปข้อมูลรายตำบล
      </div>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0" style="font-size: 0.9rem;">
        <thead class="table-light text-secondary border-bottom">
          <tr>
            <th class="py-3 px-4">ตำบล</th>
            <th class="py-3 px-3 text-end" style="width: 140px;">กลุ่ม 1</th>
            <th class="py-3 px-3 text-end" style="width: 140px;">กลุ่ม 2</th>
            <th class="py-3 px-3 text-end" style="width: 140px;">กลุ่ม 3</th>
            <th class="py-3 px-3 text-end" style="width: 140px;">รอสำรวจ</th>
            <th class="py-3 px-4 text-end" style="width: 140px;">รวม</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var s in Model.Summary)
          {
            <tr>
              <td class="py-2.5 px-4 fw-semibold text-primary">ต.@s.TumbolName</td>
              <td class="text-end text-secondary">@s.Group1CardHolder.ToString("N0")</td>
              <td class="text-end text-secondary">@s.Group2Missed.ToString("N0")</td>
              <td class="text-end text-secondary">@s.Group3NotTarget.ToString("N0")</td>
              <td class="text-end text-secondary">@s.WaitingSurvey.ToString("N0")</td>
              <td class="text-end fw-bold text-dark px-4">@s.Total.ToString("N0")</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
}

<!-- ตารางรายชื่อบุคคล -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
  <div class="card-header py-3 px-4 d-flex align-items-center justify-content-between border-bottom">
    <div class="fw-bold fs-6 text-dark d-flex align-items-center gap-2">
      <i class="bi bi-person-lines-fill text-primary"></i> รายชื่อบุคคล 
      <span class="text-muted fw-normal fs-7">(@Model.RowCount.ToString("N0") รายการ)</span>
    </div>
  </div>
  
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0" style="font-size: 0.88rem;">
      <thead class="table-light text-secondary border-bottom">
        <tr>
          <th class="py-3 px-4" style="width: 180px;">เลขประจำตัว</th>
          <th class="py-3 px-3">ชื่อ-นามสกุล</th>
          <th class="py-3 px-3 text-center" style="width: 180px;">สถานะ</th>
          <th class="py-3 px-3 text-center" style="width: 140px;">รหัสบ้าน</th>
          <th class="py-3 px-3">หมู่บ้าน/ตำบล/อำเภอ</th>
          <th class="py-3 px-4 text-center" style="width: 110px;">การจัดการ</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var m in Model.Members)
        {
          <tr>
            <td class="px-4 text-muted font-monospace">@m.CitizenIdMasked</td>
            <td class="fw-semibold text-dark">@m.FullName</td>
            <td class="text-center">
              <span class="badge @Lbl.Css(m.WelfareStatusId) rounded-pill px-3 py-1 fw-normal" style="font-size: 0.75rem;">
                @Lbl.Welfare(m.WelfareStatusId)
              </span>
            </td>
            <td class="text-center">
              <a href="@Url.Action("Detail", "House", new { code = m.HouseCode, year = Model.Year })" class="text-decoration-none text-primary font-monospace fw-semibold">
                @m.HouseCode
              </a>
            </td>
            <td class="text-secondary">@m.VillageName / ต.@m.TumbolName / อ.@m.AmphurName</td>
            <td class="text-center px-4">
              <a class="btn btn-sm btn-outline-primary rounded-3 px-2 py-1" style="font-size: 0.8rem;" href="@Url.Action("Person", "House", new { id = m.MemberId })">
                รายละเอียด
              </a>
            </td>
          </tr>
        }
        @if (Model.Members.Count == 0)
        {
          <tr>
            <td colspan="6" class="text-center text-muted py-4">@(Model.AmphurId == null && Model.TumbolId == null ? "กรุณาเลือกอำเภอหรือตำบลก่อน เพื่อแสดงรายชื่อบุคคล" : "ไม่พบข้อมูลรายชื่อบุคคล")</td>
          </tr>
        }
      </tbody>
    </table>
  </div>

  <!-- ส่วนแสดงหน้า (Pagination) -->
  <div class="card-footer bg-white py-3 px-4 d-flex justify-content-between align-items-center border-top">
    <span class="small text-muted">หน้า <b>@Model.Page</b> จากทั้งหมด <b>@Model.Pages</b> หน้า</span>
    <div class="d-flex gap-1">
      @if (Model.Page > 1)
      {
        <a class="btn btn-sm btn-outline-secondary rounded-3 px-3" href="@Url.Action("Index", new { year = Model.Year, amphurId = Model.AmphurId, tumbolId = Model.TumbolId, group = Model.Group, q = Model.Q, page = Model.Page - 1 })">
          <i class="bi bi-chevron-left me-1"></i>ก่อนหน้า
        </a>
      }
      @if (Model.Page < Model.Pages)
      {
        <a class="btn btn-sm btn-outline-secondary rounded-3 px-3" href="@Url.Action("Index", new { year = Model.Year, amphurId = Model.AmphurId, tumbolId = Model.TumbolId, group = Model.Group, q = Model.Q, page = Model.Page + 1 })">
          ถัดไป<i class="bi bi-chevron-right ms-1"></i>
        </a>
      }
    </div>
  </div>
</div>