@{
    var ctl = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "").ToLowerInvariant();
    var act = (ViewContext.RouteData.Values["action"]?.ToString() ?? "").ToLowerInvariant();
    string On(params string[] c) => c.Contains(ctl) ? "active" : "";
    var reportActs = new[] { "health", "over18", "ppp", "vulnerable", "poor" };
    var reportOn = (ctl == "report" && reportActs.Contains(act)) || ctl == "disease" || ctl == "vulnerable" || ctl == "healthresource" ? "active" : "";
    var userName = User.Identity?.Name ?? "";
    var initial = userName.Length > 0 ? userName.Substring(0, 1).ToUpperInvariant() : "?";
}
<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] - SLDC สกลนคร</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
  <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
  <nav class="navbar navbar-expand-xl app-nav sticky-top no-print">
    <div class="container-fluid px-lg-4">
      <a class="navbar-brand d-flex align-items-center me-xl-4" href="/">
        <span class="brand-icon"><i class="bi bi-geo-alt-fill fs-5"></i></span>
        <span>
          <span class="d-block brand-title">SLDC สกลนคร</span>
          <span class="d-none d-sm-block brand-sub">ระบบศูนย์กลางข้อมูลจังหวัดสกลนคร</span>
        </span>
      </a>

      @if (User.Identity?.IsAuthenticated == true)
      {
        <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-label="เมนู">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div id="nav" class="collapse navbar-collapse">
          <ul class="navbar-nav me-auto align-items-xl-center gap-xl-1 py-2 py-xl-0">
            <li class="nav-item"><a class="nav-link @(ctl == "home" ? "active" : "")" href="/"><i class="bi bi-speedometer2 me-1"></i>ภาพรวม</a></li>
            <li class="nav-item"><a class="nav-link @(ctl == "report" && act == "population" || ctl == "population" ? "active" : "")" asp-controller="Report" asp-action="Population"><i class="bi bi-people me-1"></i>ประชากร</a></li>
            <li class="nav-item"><a class="nav-link @(ctl == "report" && act == "household" || ctl == "house" || ctl == "member" ? "active" : "")" asp-controller="Report" asp-action="Household"><i class="bi bi-houses me-1"></i>ครัวเรือน</a></li>
            <li class="nav-item"><a class="nav-link @On("welfare")" asp-controller="Welfare" asp-action="Index"><i class="bi bi-card-checklist me-1"></i>บัตรสวัสดิการ</a></li>

            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle @reportOn" href="#" data-bs-toggle="dropdown"><i class="bi bi-bar-chart-line me-1"></i>รายงาน</a>
              <ul class="dropdown-menu">
                <li><a class="dropdown-item" asp-controller="Report" asp-action="Health"><i class="bi bi-heart-pulse me-2 text-danger"></i>สถิติด้านสุขภาพ</a></li>
                <li><a class="dropdown-item" asp-controller="Report" asp-action="Vulnerable"><i class="bi bi-shield-exclamation me-2 text-warning"></i>กลุ่มเปราะบาง 14 เป้าหมาย</a></li>
                <li><a class="dropdown-item" asp-controller="Report" asp-action="Poor"><i class="bi bi-house-exclamation me-2 text-danger"></i>ครัวเรือนยากจน</a></li>
                <li><a class="dropdown-item" asp-controller="Report" asp-action="Ppp"><i class="bi bi-diagram-3 me-2 text-primary"></i>กลุ่ม PPPConnext</a></li>
                <li><a class="dropdown-item" asp-controller="Report" asp-action="Over18"><i class="bi bi-person-exclamation me-2 text-secondary"></i>อายุ ≥ 18 ปี ไม่มีบัตร</a></li>
              </ul>
            </li>

            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle @On("repair")" href="#" data-bs-toggle="dropdown"><i class="bi bi-life-preserver me-1"></i>งานช่วยเหลือ</a>
              <ul class="dropdown-menu">
                <li><a class="dropdown-item" asp-controller="Repair" asp-action="House"><i class="bi bi-tools me-2 text-warning"></i>ซ่อมแซมบ้านเรือน</a></li>
                <li><a class="dropdown-item" asp-controller="Repair" asp-action="Medical"><i class="bi bi-bandaid me-2 text-info"></i>ซ่อมอุปกรณ์ทางการแพทย์</a></li>
              </ul>
            </li>

            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle @On("survey", "export")" href="#" data-bs-toggle="dropdown"><i class="bi bi-clipboard2-data me-1"></i>ภาคสนาม &amp; ข้อมูล</a>
              <ul class="dropdown-menu">
                <li><a class="dropdown-item" asp-controller="Survey" asp-action="Index"><i class="bi bi-ui-checks-grid me-2 text-success"></i>แบบสำรวจอัปเดตข้อมูล</a></li>
                <li><a class="dropdown-item" asp-controller="Export" asp-action="Index"><i class="bi bi-box-arrow-down me-2 text-primary"></i>ส่งออกข้อมูล</a></li>
                <li><a class="dropdown-item" asp-controller="OpenData" asp-action="Index"><i class="bi bi-globe2 me-2 text-info"></i>ข้อมูลเปิดสำหรับประชาชน</a></li>
              </ul>
            </li>

            @if (User.IsInRole("admin"))
            {
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle @On("users", "locations", "master", "logs")" href="#" data-bs-toggle="dropdown"><i class="bi bi-gear me-1"></i>ผู้ดูแลระบบ</a>
                <ul class="dropdown-menu">
                  <li><a class="dropdown-item" asp-controller="Users" asp-action="Index"><i class="bi bi-person-gear me-2 text-primary"></i>ผู้ใช้งานระบบ</a></li>
                  <li><a class="dropdown-item" asp-controller="Locations" asp-action="Index"><i class="bi bi-map me-2 text-success"></i>ข้อมูลพื้นที่</a></li>
                  <li><a class="dropdown-item" asp-controller="Master" asp-action="Index"><i class="bi bi-database-gear me-2 text-info"></i>ข้อมูลหลัก (โรค อาชีพ ฯลฯ)</a></li>
                  <li><a class="dropdown-item" asp-controller="Logs" asp-action="Index"><i class="bi bi-journal-text me-2 text-secondary"></i>ประวัติการใช้งาน</a></li>
                </ul>
              </li>
            }
          </ul>

          <div class="dropdown ms-xl-2 mt-2 mt-xl-0">
            <a class="user-chip text-decoration-none dropdown-toggle" href="#" data-bs-toggle="dropdown">
              <span class="avatar">@initial</span>@userName
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key me-2"></i>เปลี่ยนรหัสผ่าน</a></li>
              <li><hr class="dropdown-divider" /></li>
              <li><a class="dropdown-item text-danger" href="/Account/Logout"><i class="bi bi-box-arrow-right me-2"></i>ออกจากระบบ</a></li>
            </ul>
          </div>
        </div>
      }
      else
      {
        <div class="ms-auto d-flex gap-2">
          <a class="btn btn-sm btn-outline-secondary" asp-controller="OpenData" asp-action="Index"><i class="bi bi-globe2"></i> ข้อมูลเปิด</a>
          <a class="btn btn-sm btn-primary" href="/Account/Login"><i class="bi bi-box-arrow-in-right"></i> เข้าสู่ระบบ</a>
        </div>
      }
    </div>
  </nav>

  <main class="main-content container">
    <partial name="_Flash" />
    @RenderBody()
  </main>

  <footer class="app-footer no-print">
    <div class="container">SLDC · ระบบศูนย์กลางข้อมูลจังหวัดสกลนคร</div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
