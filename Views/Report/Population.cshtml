@model List<PopRow>
@{ 
    ViewData["Title"] = "ข้อมูลประชากร"; 
    var year = (int)ViewBag.Year;

    // คำนวณยอดรวมทั้งจังหวัด
    var totalPop = Model.Sum(x => x.Population);
    var totalMale = Model.Sum(x => x.Male);
    var totalFemale = Model.Sum(x => x.Female);
    var totalHouseholds = Model.Sum(x => x.Households);
    var totalElderly = Model.Sum(x => x.Elderly);
    var totalDisabled = Model.Sum(x => x.Disabled);
}

<!-- ส่วนหัวเรื่อง (Header) -->
<div class="page-head">
  <div>
    <h4 class="page-title">
      <i class="bi bi-people-fill"></i> ข้อมูลประชากร
    </h4>
    <div class="page-sub">
      ข้อมูลจำนวนประชากรจำแนกรายอำเภอ ปี พ.ศ. @year
    </div>
  </div>
  <div class="page-actions">
    <a class="btn btn-success btn-sm rounded-3 px-3 fw-semibold shadow-sm" asp-controller="Population" asp-action="Create"><i class="bi bi-person-plus"></i> เพิ่มข้อมูลประชากร</a>
    <partial name="_YearSelect" model="year" />
  </div>
</div>

<!-- การ์ดสรุปตัวเลข 4 ช่อง สไตล์ซอฟต์ -->
<div class="row g-3 mb-4">
  <!-- 1. ประชากรทั้งหมด -->
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card border-0 shadow-sm rounded-4 h-100 p-3" style="background-color: #f0f9ff; border-left: 5px solid #0284c7 !important;">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <div class="fs-2 fw-bold text-dark">@totalPop.ToString("N0")</div>
          <div class="small text-secondary fw-semibold mt-1">
            <i class="bi bi-people me-1"></i>ประชากรทั้งหมด
          </div>
        </div>
        <div class="rounded-circle p-3 d-flex align-items-center justify-content-center" style="background-color: rgba(2, 132, 199, 0.1); width: 54px; height: 54px;">
          <i class="bi bi-people-fill fs-3 text-primary"></i>
        </div>
      </div>
    </div>
  </div>

  <!-- 2. เพศชาย -->
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card border-0 shadow-sm rounded-4 h-100 p-3" style="background-color: #f0fdf4; border-left: 5px solid #16a34a !important;">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <div class="fs-2 fw-bold text-dark">@totalMale.ToString("N0")</div>
          <div class="small text-secondary fw-semibold mt-1">
            <i class="bi bi-gender-male me-1 text-success"></i>เพศชาย
          </div>
        </div>
        <div class="rounded-circle p-3 d-flex align-items-center justify-content-center" style="background-color: rgba(22, 163, 74, 0.1); width: 54px; height: 54px;">
          <i class="bi bi-gender-male fs-3 text-success"></i>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. เพศหญิง -->
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card border-0 shadow-sm rounded-4 h-100 p-3" style="background-color: #fdf2f8; border-left: 5px solid #db2777 !important;">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <div class="fs-2 fw-bold text-dark">@totalFemale.ToString("N0")</div>
          <div class="small text-secondary fw-semibold mt-1">
            <i class="bi bi-gender-female me-1" style="color: #db2777;"></i>เพศหญิง
          </div>
        </div>
        <div class="rounded-circle p-3 d-flex align-items-center justify-content-center" style="background-color: rgba(219, 39, 119, 0.1); width: 54px; height: 54px;">
          <i class="bi bi-gender-female fs-3" style="color: #db2777;"></i>
        </div>
      </div>
    </div>
  </div>

  <!-- 4. ครัวเรือนทั้งหมด -->
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="card border-0 shadow-sm rounded-4 h-100 p-3" style="background-color: #fff7ed; border-left: 5px solid #ea580c !important;">
      <div class="d-flex align-items-center justify-content-between">
        <div>
          <div class="fs-2 fw-bold text-dark">@totalHouseholds.ToString("N0")</div>
          <div class="small text-secondary fw-semibold mt-1">
            <i class="bi bi-house-door me-1 text-warning"></i>ครัวเรือนทั้งหมด
          </div>
        </div>
        <div class="rounded-circle p-3 d-flex align-items-center justify-content-center" style="background-color: rgba(234, 88, 12, 0.1); width: 54px; height: 54px;">
          <i class="bi bi-house-door-fill fs-3 text-warning"></i>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ตารางข้อมูลประชากรรายอำเภอ -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
  <div class="card-header py-3 px-4 d-flex align-items-center justify-content-between border-0">
    <div class="fw-bold fs-6 d-flex align-items-center gap-2">
      <i class="bi bi-table"></i> ตารางข้อมูลประชากรรายอำเภอ
    </div>
  </div>
  
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0" style="font-size: 0.9rem;">
      <thead class="table-light text-secondary border-bottom">
        <tr>
          <th class="py-3 px-3 text-center" style="width: 50px;">#</th>
          <th class="py-3 px-3">อำเภอ</th>
          <th class="py-3 px-3 text-end">ประชากรทั้งหมด</th>
          <th class="py-3 px-3 text-end">ชาย</th>
          <th class="py-3 px-3 text-end">หญิง</th>
          <th class="py-3 px-3 text-end">ครัวเรือน</th>
          <th class="py-3 px-3 text-end">ผู้สูงอายุ</th>
          <th class="py-3 px-3 text-end">ผู้พิการ</th>
          <th class="py-3 px-3 text-center" style="min-width: 150px;">สัดส่วนชาย/หญิง</th>
        </tr>
      </thead>
      <tbody>
        @{ var n = 0; }
        @foreach (var r in Model)
        {
          double malePercent = r.Population > 0 ? ((double)r.Male / r.Population) * 100 : 50;

          <tr>
            <td class="text-center text-muted">@(++n)</td>
            <td class="fw-semibold text-primary">
              <a href="@Url.Action("Tambon", "Home", new { amphurId = r.AmphurId, year })" class="text-decoration-none text-primary">
                อ.@r.AmphurName
              </a>
            </td>
            <td class="text-end fw-bold text-dark">@r.Population.ToString("N0")</td>
            <td class="text-end text-secondary">@r.Male.ToString("N0")</td>
            <td class="text-end text-secondary">@r.Female.ToString("N0")</td>
            <td class="text-end text-secondary">@r.Households.ToString("N0")</td>
            <td class="text-end text-secondary">@r.Elderly.ToString("N0")</td>
            <td class="text-end text-secondary">@r.Disabled.ToString("N0")</td>
            <td class="text-center px-3">
              <div class="d-flex align-items-center gap-2 justify-content-center">
                <div class="progress flex-grow-1" style="height: 6px; background-color: #fbcfe8; border-radius: 3px;">
                  <div class="progress-bar bg-primary" style="width: @malePercent.ToString("F0")%; border-radius: 3px;"></div>
                </div>
                <span class="small text-muted fw-semibold" style="width: 38px; font-size: 0.78rem;">
                  @(r.SexRatio?.ToString("0.00") ?? "-")
                </span>
              </div>
            </td>
          </tr>
        }
        @if (Model.Count == 0)
        {
          <tr>
            <td colspan="9" class="text-center text-muted py-4">ยังไม่มีข้อมูลปี @year</td>
          </tr>
        }
      </tbody>
      
      <!-- แถบรวมทั้งจังหวัด ท้ายตาราง -->
      <tfoot class="table-light fw-bold border-top">
        <tr class="bg-light">
          <td colspan="2" class="py-3 px-3 text-center text-dark">รวมทั้งจังหวัด</td>
          <td class="text-end py-3 text-primary fs-6">@totalPop.ToString("N0")</td>
          <td class="text-end py-3 text-dark">@totalMale.ToString("N0")</td>
          <td class="text-end py-3 text-dark">@totalFemale.ToString("N0")</td>
          <td class="text-end py-3 text-dark">@totalHouseholds.ToString("N0")</td>
          <td class="text-end py-3 text-dark">@totalElderly.ToString("N0")</td>
          <td class="text-end py-3 text-dark">@totalDisabled.ToString("N0")</td>
          <td class="text-center py-3">
            @{
              double totalMalePercent = totalPop > 0 ? ((double)totalMale / totalPop) * 100 : 50;
              double totalRatio = totalFemale > 0 ? (double)totalMale / totalFemale : 0;
            }
            <div class="d-flex align-items-center gap-2 justify-content-center px-2">
              <div class="progress flex-grow-1" style="height: 6px; background-color: #fbcfe8; border-radius: 3px;">
                <div class="progress-bar bg-primary" style="width: @totalMalePercent.ToString("F0")%; border-radius: 3px;"></div>
              </div>
              <span class="small text-dark fw-bold" style="width: 38px; font-size: 0.78rem;">@totalRatio.ToString("0.00")</span>
            </div>
          </td>
        </tr>
      </tfoot>
    </table>
  </div>
</div>

<!-- กราฟเปรียบเทียบประชากรรายอำเภอ -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
  <div class="card-header py-3 px-4 fw-bold border-bottom">
    <i class="bi bi-bar-chart-line text-primary me-1"></i> กราฟเปรียบเทียบประชากรรายอำเภอ
  </div>
  <div class="card-body p-3">
    <canvas id="popChart" height="110"></canvas>
  </div>
</div>

@section Scripts {
<script>
new Chart(document.getElementById('popChart'), {
  type: 'bar',
  data: { 
    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(x => "อ." + x.AmphurName))),
    datasets: [
      { label: 'ชาย', data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(x => x.Male))), backgroundColor: '#60a5fa', borderRadius: 4 },
      { label: 'หญิง', data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(x => x.Female))), backgroundColor: '#f472b6', borderRadius: 4 }
    ] 
  },
  options: { 
    responsive: true,
    scales: { 
      x: { stacked: true, grid: { display: false } }, 
      y: { stacked: true, grid: { color: '#f1f5f9' } } 
    } 
  }
});
</script>
}