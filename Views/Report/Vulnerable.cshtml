@model VulVm
@{
    ViewData["Title"] = "กลุ่มเปราะบาง 14 เป้าหมาย";
    var top = Model.Rows.OrderByDescending(x => x.People).FirstOrDefault();

    // ฟังก์ชั่นจับคู่ไอคอนและสีประจำแต่ละประเภทกลุ่มเปราะบาง (1-14)
    (string Icon, string Color) GetMeta(int typeId) => typeId switch
    {
        1 => ("bi-hospital-fill", "#2563eb"),            // ป่วยติดเตียง (ฟ้า)
        2 => ("bi-person-wheelchair", "#7c3aed"),        // พิการ (ม่วง)
        3 => ("bi-person-walking", "#f97316"),           // สูงอายุ (ส้ม)
        4 => ("bi-emoji-smile-fill", "#10b981"),         // เด็กต่ำกว่า 6 ปี (เขียว)
        5 => ("bi-house-heart-fill", "#0d9488"),         // คนเร่ร่อน (เขียวเทอร์ควอยซ์)
        6 => ("bi-capsule", "#dc2626"),                  // ติดยา (แดง)
        7 => ("bi-person-heart", "#ec4899"),             // ท้องก่อนเกณฑ์ (ชมพู)
        8 => ("bi-heart-pulse-fill", "#e11d48"),         // NCD (แดงเข้ม)
        9 => ("bi-stethoscope", "#0284c7"),              // IMC (ฟ้าสด)
        10 => ("bi-briefcase-fill", "#ea580c"),          // ตกงาน (น้ำตาลส้ม)
        11 => ("bi-house-exclamation-fill", "#ef4444"),  // รุนแรงในครอบครัว (แดงสด)
        12 => ("bi-bank", "#6d28d9"),                    // โดนโกง/หนี้สิน (ม่วงเข้ม)
        13 => ("bi-activity", "#0f766e"),                // ฟอกไต (เขียวมรกต)
        14 => ("bi-ribbon", "#db2777"),                  // มะเร็ง (ชมพูเข้ม)
        _ => ("bi-person-fill", "#64748b")
    };
}

<!-- ส่วนหัวเรื่อง (Banner Header) -->
<div class="page-head">
  <div>
    <h4 class="page-title">
      <i class="bi bi-shield-exclamation"></i> 14 เป้าหมายกลุ่มเปราะบาง
    </h4>
    <div class="page-sub">
      สถิติการสำรวจและคัดกรองกลุ่มเปราะบางที่ต้องได้รับการดูแลและช่วยเหลือในพื้นที่ ปี พ.ศ. @Model.Year
    </div>
  </div>
  <div class="page-actions">
    <partial name="_YearSelect" model="Model.Year" />
  </div>
</div>

<!-- การ์ด 14 เป้าหมายกลุ่มเปราะบาง (แบบมีไอคอนแยกสี) -->
<div class="row g-2 mb-4">
  @foreach (var r in Model.Rows)
  {
    bool isSelected = Model.Selected == r.VulnerableTypeId;
    var meta = GetMeta(r.VulnerableTypeId);

    <div class="col-6 col-md-4 col-lg-3 col-xl-2">
      <a class="text-decoration-none" href="@Url.Action("Vulnerable", new { year = Model.Year, type = r.VulnerableTypeId })">
        <div class="card h-100 border-0 shadow-sm rounded-4 p-2.5 transition-all @(isSelected ? "shadow-lg" : "")" style="background-color: #ffffff; @(isSelected ? $"border: 2px solid {meta.Color} !important;" : "")">
          <div class="d-flex align-items-center gap-2">
            <!-- กล่องไอคอนประจำกลุ่ม -->
            <div class="rounded-3 d-flex align-items-center justify-content-center text-white flex-shrink-0" style="background-color: @meta.Color; width: 42px; height: 42px;">
              <i class="bi @meta.Icon fs-5"></i>
            </div>
            <div class="overflow-hidden">
              <div class="small text-muted fw-semibold text-truncate" title="@r.VulnerableTypeId. @r.NameTh" style="font-size: 0.75rem;">
                @r.VulnerableTypeId. @r.NameTh
              </div>
              <div class="fs-4 fw-bold text-dark lh-1 mt-1">
                @r.People.ToString("N0")
              </div>
            </div>
          </div>
        </div>
      </a>
    </div>
  }
</div>

<!-- กราฟสถิติตามประเภท -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
  <div class="card-header py-3 px-4 fw-bold border-bottom d-flex align-items-center gap-2">
    <i class="bi bi-bar-chart-line-fill text-primary"></i> แผนภูมิแสดงสถิติตามประเภทกลุ่มเปราะบาง
  </div>
  <div class="card-body p-3">
    <canvas id="vulChart" height="100"></canvas>
  </div>
</div>

<!-- ตารางแสดงรายชื่อ (เมื่อคลิกเลือกกลุ่ม) -->
@if (Model.Selected != null)
{
  var selectedGroup = Model.Rows.FirstOrDefault(x => x.VulnerableTypeId == Model.Selected);
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="card-header py-3 px-4 d-flex align-items-center justify-content-between border-0">
      <div class="fw-bold fs-6 d-flex align-items-center gap-2">
        <i class="bi bi-person-lines-fill"></i> รายชื่อกลุ่ม: @(selectedGroup?.NameTh)
      </div>
      <div class="d-flex align-items-center gap-3">
        <span class="small opacity-75">ทั้งหมด @Model.Members.Count.ToString("N0") รายการ</span>
        <a class="btn btn-sm btn-light rounded-3 fw-semibold" asp-controller="Vulnerable" asp-action="Create" asp-route-typeId="@Model.Selected"><i class="bi bi-plus-lg"></i> เพิ่มบุคคลเข้ากลุ่มนี้</a>
      </div>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0" style="font-size: 0.88rem;">
        <thead class="table-light text-secondary border-bottom">
          <tr>
            <th class="py-3 px-4">ชื่อ-นามสกุล</th>
            <th class="py-3 px-3" style="width: 170px;">เลขประจำตัว</th>
            <th class="py-3 px-3 text-center" style="width: 80px;">อายุ</th>
            <th class="py-3 px-3 text-center" style="width: 140px;">รหัสบ้าน</th>
            <th class="py-3 px-3">หมู่บ้าน/ตำบล/อำเภอ</th>
            <th class="py-3 px-4 text-center" style="width: 190px;">การจัดการ</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var m in Model.Members)
          {
            <tr>
              <td class="px-4 fw-semibold text-dark">@m.FullName</td>
              <td class="text-muted font-monospace">@m.CitizenIdMasked</td>
              <td class="text-center fw-semibold text-dark">@m.Age</td>
              <td class="text-center">
                <a href="@Url.Action("Detail", "House", new { code = m.HouseCode, year = Model.Year })" class="text-decoration-none font-monospace text-primary fw-semibold">
                  @m.HouseCode
                </a>
              </td>
              <td class="text-secondary">@m.VillageName / ต.@m.TumbolName / อ.@m.AmphurName</td>
              <td class="text-center px-4">
                <a class="btn btn-sm btn-primary rounded-3 px-3 py-1 fw-semibold" style="font-size: 0.8rem;" href="@Url.Action("Person", "House", new { id = m.MemberId })">
                  ดู
                </a>
                <form asp-controller="Vulnerable" asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('นำ @m.FullName ออกจากกลุ่มนี้?')">
                  <input type="hidden" name="memberId" value="@m.MemberId" /><input type="hidden" name="typeId" value="@Model.Selected" />
                  <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                  <button class="btn btn-sm btn-outline-danger rounded-3 px-2 py-1" style="font-size: 0.8rem;">นำออก</button>
                </form>
              </td>
            </tr>
          }
          @if (Model.Members.Count == 0)
          {
            <tr>
              <td colspan="6" class="text-center text-muted py-5">ไม่พบรายชื่อในกลุ่มนี้</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
}

@section Scripts {
<script>
// สีกราฟตรงตามไอคอนเป้าหมาย 14 กลุ่ม
const chartColors = [
  '#2563eb', '#7c3aed', '#f97316', '#10b981', '#0d9488', 
  '#dc2626', '#ec4899', '#e11d48', '#0284c7', '#ea580c', 
  '#ef4444', '#6d28d9', '#0f766e', '#db2777'
];

new Chart(document.getElementById('vulChart'), {
  type: 'bar',
  data: { 
    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Rows.Select(x => x.VulnerableTypeId + ". " + x.NameTh))),
    datasets: [{ 
      data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Rows.Select(x => x.People))), 
      backgroundColor: chartColors,
      borderRadius: 6
    }] 
  },
  options: { 
    responsive: true,
    plugins: { 
      legend: { display: false } 
    },
    scales: {
      x: { grid: { display: false } },
      y: { grid: { color: '#f1f5f9' }, beginAtZero: true }
    }
  }
});
</script>
}