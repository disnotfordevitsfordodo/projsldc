@model UsersVm
@{
    ViewData["Title"] = "จัดการผู้ใช้งานระบบ";
    var pager = new PagerVm { Page = Model.Users.Page, Pages = Model.Users.Pages, Total = Model.Users.Total, Href = p => Url.Action("Index", new { q = Model.Q, page = p }) };
}

<!-- ส่วนหัวเรื่อง (Header) + ปุ่มเพิ่มผู้ใช้งาน -->
<div class="page-head">
  <div>
    <h4 class="page-title">
      <i class="bi bi-person-gear"></i> จัดการผู้ใช้งานระบบ
    </h4>
    <div class="page-sub">
      เพิ่ม ลบ พร้อมแก้ไขข้อมูลผู้ใช้งานระบบและกำหนดสิทธิ์
    </div>
  </div>
  <div class="page-actions"><a class="btn btn-success" asp-action="Edit"><i class="bi bi-plus-lg"></i> เพิ่มผู้ใช้งาน</a></div>
</div>


<!-- การ์ดตารางรายชื่อผู้ใช้งานในระบบ -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
  <div class="card-header py-3 px-4 d-flex align-items-center justify-content-between border-0">
    <div class="fw-bold fs-6 d-flex align-items-center gap-2">
      <i class="bi bi-card-heading"></i> รายชื่อผู้ใช้งานในระบบ
    </div>
  </div>

  <div class="card-body p-3">
    <!-- แถบตัวเลือกจำนวนแสดงผล และช่องค้นหา -->
    <form method="get" class="d-flex justify-content-between align-items-center mb-3">
      <div class="d-flex align-items-center gap-2 small text-muted">
        แสดง 
        <select name="pageSize" class="form-select form-select-sm rounded-2" style="width: 75px;" onchange="this.form.submit()">
          <option value="10" selected>10</option>
          <option value="25">25</option>
          <option value="50">50</option>
        </select>
        แถว
      </div>

      <div class="d-flex align-items-center gap-2 small">
        <label class="text-muted fw-semibold">ค้นหา :</label>
        <input name="q" value="@Model.Q" class="form-control form-control-sm rounded-2" style="width: 200px;" onchange="this.form.submit()" />
      </div>
    </form>

    <!-- ตารางผู้ใช้งาน -->
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0" style="font-size: 0.88rem;">
        <thead class="table-light text-secondary border-bottom">
          <tr>
            <th class="py-3 px-3">ชื่อผู้ใช้งาน (Username)</th>
            <th class="py-3 px-3">ชื่อ-นามสกุล</th>
            <th class="py-3 px-3 text-center" style="width: 180px;">สิทธิ์การใช้งาน (Role)</th>
            <th class="py-3 px-3 text-center" style="width: 130px;">รหัสอำเภอ</th>
            <th class="py-3 px-3 text-center" style="width: 130px;">รหัสตำบล</th>
            <th class="py-3 px-3 text-center" style="width: 110px;">จัดการ</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var u in Model.Users.Items)
          {
            // กำหนดสี Badge ตามประเภทสิทธิ์
            string roleStyle = u.Role == "admin" ? "background-color: #fce7f3; color: #db2777;" :
                               u.Role == "amphur" ? "background-color: #fef3c7; color: #d97706;" :
                               "background-color: #d1fae5; color: #059669;";

            <tr>
              <td class="px-3 fw-semibold text-dark">@u.Username</td>
              <td class="text-secondary">@u.FullName</td>
              <td class="text-center">
                <span class="badge rounded-2 px-2.5 py-1 fw-normal font-monospace" style="@roleStyle font-size: 0.75rem;">
                  @u.Role
                </span>
              </td>
              <td class="text-center font-monospace text-muted">@(u.AmphurId?.ToString() ?? "-")</td>
              <td class="text-center font-monospace text-muted">@(u.TumbolId?.ToString() ?? "-")</td>
              <td class="text-center px-3 text-nowrap">
                <!-- ปุ่มแก้ไข -->
                <a class="btn btn-sm btn-primary p-1 px-2 rounded-2 me-1" asp-action="Edit" asp-route-id="@u.UserId" title="แก้ไข">
                  <i class="bi bi-pencil-square"></i>
                </a>

                <!-- ปุ่มลบ -->
                @if (u.Username != "admin")
                {
                  <form asp-action="Delete" asp-route-id="@u.UserId" method="post" class="d-inline" onsubmit="return confirm('ยืนยันการลบผู้ใช้ @u.Username ?')">
                    <button type="submit" class="btn btn-sm btn-danger p-1 px-2 rounded-2" title="ลบ">
                      <i class="bi bi-trash-fill"></i>
                    </button>
                  </form>
                }
              </td>
            </tr>
          }
          @if (Model.Users.Items.Count == 0)
          {
            <tr>
              <td colspan="6" class="text-center text-muted py-5">ไม่พบข้อมูลผู้ใช้งาน</td>
            </tr>
          }
        </tbody>
      </table>
    </div>

    <!-- ส่วนแสดงยอดรายการและตัวแบ่งหน้า -->
    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top px-2">
      <div class="small text-muted">
        แสดง 1 ถึง @Model.Users.Items.Count จาก @Model.Users.Total แถว
      </div>
      <div>
        <partial name="_Pager" model="pager" />
      </div>
    </div>
  </div>
</div>