@using Microsoft.AspNetCore.Diagnostics
@inject IWebHostEnvironment Env
@{
    ViewData["Title"] = "เกิดข้อผิดพลาด";
    var ex = Context.Features.Get<IExceptionHandlerFeature>()?.Error;
    var code = Context.Request.Query["code"].ToString();
    var msg = code == "404" ? "ไม่พบหน้าที่ต้องการ"
            : code == "403" ? "คุณไม่มีสิทธิ์เข้าถึงหน้านี้"
            : "ระบบเชื่อมต่อฐานข้อมูลไม่ได้หรือเกิดปัญหาระหว่างประมวลผล";
}
<div class="card text-center"><div class="card-body py-5">
  <h3 class="text-secondary">เกิดข้อผิดพลาด</h3>
  <p class="text-muted">@msg</p>
  @if (Env.IsDevelopment() && ex != null)
  {
    <pre class="text-start bg-light border rounded p-3 small" style="white-space:pre-wrap">@ex.GetType().Name : @ex.Message</pre>
  }
  <a class="btn btn-outline-secondary" href="/">กลับหน้าแรก</a>
</div></div>
