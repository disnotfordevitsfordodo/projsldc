@model DiseaseFormVm
@{ var f = Model.Form; ViewData["Title"] = "แก้ไขข้อมูลโรค"; }
<div class="page-head"><div><h4 class="page-title"><i class="bi bi-pencil-square"></i> @ViewData["Title"]</h4></div></div><div class="text-muted small mb-3">@Model.MemberName</div>
@if (Model.Error != null) { <div class="alert alert-danger border-0 shadow-sm rounded-4">@Model.Error</div> }
<div class="card border-0 shadow-sm rounded-4" style="max-width:640px"><div class="card-body p-4">
<form asp-action="Edit" method="post"><input type="hidden" name="MemberDiseaseId" value="@f.MemberDiseaseId" /><div class="row g-3">
  <div class="col-12"><label class="form-label small fw-semibold">โรค</label><select name="DiseaseId" class="form-select" required>
    @foreach (var d in Model.Diseases) { <option value="@d.Id" selected="@(d.Id == f.DiseaseId?.ToString())">@d.Name</option> }</select></div>
  <div class="col-12"><label class="form-label small fw-semibold">วันที่วินิจฉัย</label><input type="date" name="DiagnosedDate" value="@(f.DiagnosedDate?.ToString("yyyy-MM-dd"))" class="form-control" /></div>
  <div class="col-12"><button class="btn btn-success rounded-3 px-4">บันทึก</button> <a class="btn btn-outline-secondary rounded-3 px-4" href="javascript:history.back()">ยกเลิก</a></div>
</div></form></div></div>
