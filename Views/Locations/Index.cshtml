@model LocVm
@{
    ViewData["Title"] = "จัดการข้อมูลพื้นที่";
    var f = Model.Filter; var tab = Model.Tab;
    var vill = tab == "village"; var tumb = tab == "tumbol"; var amp = tab == "amphur";
    var pg = vill ? Model.Villages.Page : tumb ? Model.Tumbols.Page : Model.Amphurs.Page;
    var pages = vill ? Model.Villages.Pages : tumb ? Model.Tumbols.Pages : Model.Amphurs.Pages;
    var total = vill ? Model.Villages.Total : tumb ? Model.Tumbols.Total : Model.Amphurs.Total;
    var pager = new PagerVm { Page = pg, Pages = pages, Total = total, Href = p => Url.Action("Index", new { tab = Model.Tab, amphurId = f.AmphurId, tumbolId = f.TumbolId, q = f.Q, page = p }) };
}
<div class="page-head"><div><h4 class="page-title"><i class="bi bi-map"></i> จัดการข้อมูลพื้นที่</h4><div class="page-sub">อำเภอ ตำบล และหมู่บ้านที่ใช้อ้างอิงทั้งระบบ</div></div></div>
<ul class="nav nav-tabs mb-3">
  <li class="nav-item"><a class="nav-link @(amp ? "active" : "")" asp-action="Index" asp-route-tab="amphur">จัดการอำเภอ</a></li>
  <li class="nav-item"><a class="nav-link @(tumb ? "active" : "")" asp-action="Index" asp-route-tab="tumbol">จัดการตำบล</a></li>
  <li class="nav-item"><a class="nav-link @(vill ? "active" : "")" asp-action="Index" asp-route-tab="village">จัดการหมู่บ้าน</a></li>
</ul>
<div class="d-flex justify-content-between align-items-start">
  <div class="flex-grow-1">
    @if (amp)
    {
      <form method="get" class="mb-3"><input type="hidden" name="tab" value="amphur" />
        <div class="input-group" style="max-width:360px"><input name="q" value="@f.Q" class="form-control" placeholder="ค้นหา ชื่อ / รหัสอำเภอ" /><button class="btn btn-primary">ค้นหา</button></div></form>
    }
    else { <partial name="_Filter" model="f" /> }
  </div>
  @if (vill) { <a class="btn btn-success ms-2" asp-action="VillageEdit">+ เพิ่มหมู่บ้าน</a> }
  else if (tumb) { <a class="btn btn-success ms-2" asp-action="TumbolEdit">+ เพิ่มตำบล</a> }
  else { <a class="btn btn-success ms-2" asp-action="AmphurEdit">+ เพิ่มอำเภอ</a> }
</div>
<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
@if (vill)
{
  <thead><tr><th>ID</th><th>จังหวัด</th><th>อำเภอ</th><th>ตำบล</th><th>หมู่ที่</th><th>ชื่อหมู่บ้าน</th><th></th></tr></thead><tbody>
  @foreach (var v in Model.Villages.Items)
  {
    <tr><td>@v.VillageId</td><td>@v.ProvinceName</td><td>@v.AmphurName</td><td>@v.TumbolName</td><td>@v.Moo</td><td>@v.NameTh</td>
        <td class="text-nowrap"><a class="btn btn-sm btn-primary" asp-action="VillageEdit" asp-route-id="@v.VillageId">แก้ไข</a>
          <form asp-action="VillageDelete" asp-route-id="@v.VillageId" method="post" class="d-inline" onsubmit="return confirm('ยืนยันการลบหมู่บ้านนี้?')"><button class="btn btn-sm btn-danger">ลบ</button></form></td></tr>
  }
  </tbody>
}
else if (tumb)
{
  <thead><tr><th>รหัสตำบล</th><th>อำเภอ</th><th>ชื่อตำบล</th><th>รหัสไปรษณีย์</th><th class="text-end">เป้าหมาย</th><th></th></tr></thead><tbody>
  @foreach (var t in Model.Tumbols.Items)
  {
    <tr><td>@t.TumbolId</td><td>@t.AmphurName</td><td>@t.NameTh</td><td>@t.PostCode</td><td class="text-end">@t.Target</td>
        <td class="text-nowrap"><a class="btn btn-sm btn-primary" asp-action="TumbolEdit" asp-route-id="@t.TumbolId">แก้ไข</a>
          <form asp-action="TumbolDelete" asp-route-id="@t.TumbolId" method="post" class="d-inline" onsubmit="return confirm('ยืนยันการลบตำบลนี้?')"><button class="btn btn-sm btn-danger">ลบ</button></form></td></tr>
  }
  </tbody>
}
else
{
  <thead><tr><th>รหัสอำเภอ</th><th>ชื่ออำเภอ</th><th>ชื่อ (อังกฤษ)</th><th></th></tr></thead><tbody>
  @foreach (var a in Model.Amphurs.Items)
  {
    <tr><td>@a.AmphurId</td><td>@a.NameTh</td><td>@a.NameEn</td>
        <td class="text-nowrap"><a class="btn btn-sm btn-primary" asp-action="AmphurEdit" asp-route-id="@a.AmphurId">แก้ไข</a>
          <form asp-action="AmphurDelete" asp-route-id="@a.AmphurId" method="post" class="d-inline" onsubmit="return confirm('ยืนยันการลบอำเภอนี้?')"><button class="btn btn-sm btn-danger">ลบ</button></form></td></tr>
  }
  </tbody>
}
</table></div><partial name="_Pager" model="pager" /></div>
