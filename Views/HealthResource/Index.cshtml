@model ResourceListVm
@{
    ViewData["Title"] = "ทรัพยากรสุขภาพ";
    var f = Model.Filter;
    var pager = new PagerVm { Page = Model.Rows.Page, Pages = Model.Rows.Pages, Total = Model.Rows.Total, Href = p => Url.Action("Index", new { type = Model.Type, amphurId = f.AmphurId, tumbolId = f.TumbolId, q = f.Q, page = p }) };
    string Th(string t) => t switch { "hospital" => "โรงพยาบาล", "rpst" => "รพ.สต.", "osm" => "อสม.", "doctor" => "แพทย์ประจำ", _ => t };
}
<div class="page-head">
  <div><h4 class="page-title"><i class="bi bi-hospital"></i> ทรัพยากรสุขภาพ</h4>
    <div class="page-sub">โรงพยาบาล รพ.สต. อสม. และแพทย์ประจำ แยกตามพื้นที่</div></div>
  <div class="page-actions"><a class="btn btn-success" asp-action="Edit"><i class="bi bi-plus-lg"></i> เพิ่มทรัพยากร</a></div>
</div>
<form method="get" class="row g-2 mb-3">
  <div class="col-md-2"><select name="type" class="form-select" onchange="this.form.submit()"><option value="">-- ทุกประเภท --</option>
    @foreach (var t in new[] { "hospital", "rpst", "osm", "doctor" }) { <option value="@t" selected="@(t == Model.Type)">@Th(t)</option> }</select></div>
  <div class="col-md-3"><select name="amphurId" class="form-select" onchange="this.form.tumbolId.value=''; this.form.submit()"><option value="">-- ทุกอำเภอ --</option>
    @foreach (var a in f.Amphurs) { <option value="@a.Id" selected="@(a.Id == f.AmphurId)">อ.@a.Name</option> }</select></div>
  <div class="col-md-3"><select name="tumbolId" class="form-select" onchange="this.form.submit()"><option value="">-- ทุกตำบล --</option>
    @foreach (var t in f.Tumbols) { <option value="@t.Id" selected="@(t.Id == f.TumbolId)">ต.@t.Name</option> }</select></div>
  <div class="col-md-4"><div class="input-group"><input name="q" value="@f.Q" class="form-control" placeholder="ค้นหาชื่อ" /><button class="btn btn-primary">ค้นหา</button></div></div>
</form>
<div class="card border-0 shadow-sm rounded-4 overflow-hidden"><div class="table-responsive">
  <table class="table table-hover align-middle mb-0" style="font-size:.9rem">
    <thead class="table-light"><tr><th>ประเภท</th><th>ชื่อ</th><th>ตำบล</th><th>อำเภอ</th><th></th></tr></thead><tbody>
    @foreach (var r in Model.Rows.Items)
    {
      <tr><td><span class="badge bg-light text-dark border">@Th(r.ResourceType)</span></td><td class="fw-semibold">@r.Name</td><td>@(r.TumbolName ?? "-")</td><td>@(r.AmphurName ?? "-")</td>
        <td class="text-nowrap text-end"><a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@r.ResourceId">แก้ไข</a>
          <form asp-action="Delete" asp-route-id="@r.ResourceId" method="post" class="d-inline" onsubmit="return confirm('ยืนยันการลบ @r.Name ?')"><button class="btn btn-sm btn-danger">ลบ</button></form></td></tr>
    }
    @if (Model.Rows.Items.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">ไม่พบข้อมูล</td></tr> }
    </tbody></table></div>
  <partial name="_Pager" model="pager" />
</div>
