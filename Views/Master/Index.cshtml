@model MasterIndexVm
@{
    ViewData["Title"] = "จัดการข้อมูลหลัก";
    var d = Model.Def;
    var pager = new PagerVm { Page = Model.Rows.Page, Pages = Model.Rows.Pages, Total = Model.Rows.Total, Href = p => Url.Action("Index", new { key = d.Key, q = Model.Q, page = p }) };
}
<div class="page-head"><div><h4 class="page-title"><i class="bi bi-database-gear"></i> จัดการข้อมูลหลัก</h4>
<div class="page-sub">ข้อมูลอ้างอิงที่ใช้ในแบบฟอร์มทั่วทั้งระบบ การปิดใช้งานจะซ่อนจากตัวเลือกแต่ไม่กระทบข้อมูลเดิม</div></div></div>
<div class="row g-3">
  <div class="col-lg-3">
    <div class="list-group shadow-sm rounded-4">
      @foreach (var x in Model.All)
      { <a class="list-group-item list-group-item-action @(x.Key == d.Key ? "active" : "")" asp-action="Index" asp-route-key="@x.Key">@x.Title</a> }
    </div>
  </div>
  <div class="col-lg-9">
    <div class="d-flex justify-content-between mb-3">
      <form method="get" class="input-group" style="max-width:360px"><input type="hidden" name="key" value="@d.Key" />
        <input name="q" value="@Model.Q" class="form-control" placeholder="ค้นหา" /><button class="btn btn-primary">ค้นหา</button></form>
      <a class="btn btn-success" asp-action="Edit" asp-route-key="@d.Key">+ เพิ่ม@(d.Title)</a>
    </div>
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden"><div class="table-responsive">
      <table class="table table-hover align-middle mb-0" style="font-size:.9rem">
        <thead class="table-light"><tr><th style="width:80px">รหัส</th>@foreach (var f in d.Fields) { <th>@f.Label</th> }
          @if (d.ActiveCol != null) { <th class="text-center">สถานะ</th> }<th style="width:210px"></th></tr></thead>
        <tbody>
        @foreach (var r in Model.Rows.Items)
        {
          var id = r[d.IdCol]?.ToString();
          var active = d.ActiveCol == null || Convert.ToInt32(r[d.ActiveCol]) != 0;
          <tr class="@(active ? "" : "text-muted")">
            <td class="font-monospace">@id</td>
            @foreach (var f in d.Fields) { <td>@r[f.Col]</td> }
            @if (d.ActiveCol != null) { <td class="text-center"><span class="badge @(active ? "bg-success" : "bg-secondary")">@(active ? "ใช้งาน" : "ปิดใช้งาน")</span></td> }
            <td class="text-nowrap text-end">
              <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-key="@d.Key" asp-route-id="@id">แก้ไข</a>
              @if (d.ActiveCol != null)
              {
                <form asp-action="Toggle" method="post" class="d-inline"><input type="hidden" name="key" value="@d.Key" /><input type="hidden" name="id" value="@id" />
                  <button class="btn btn-sm btn-outline-secondary">@(active ? "ปิดใช้งาน" : "เปิดใช้งาน")</button></form>
              }
              <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('ยืนยันการลบรายการนี้?')"><input type="hidden" name="key" value="@d.Key" /><input type="hidden" name="id" value="@id" />
                <button class="btn btn-sm btn-danger">ลบ</button></form>
            </td>
          </tr>
        }
        @if (Model.Rows.Items.Count == 0) { <tr><td colspan="9" class="text-center text-muted py-4">ไม่พบข้อมูล</td></tr> }
        </tbody>
      </table></div>
      <partial name="_Pager" model="pager" />
    </div>
  </div>
</div>
